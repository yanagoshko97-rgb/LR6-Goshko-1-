# БЛОК ОПРЕДЕЛЕНИЯ ОСНОВНОГО ФАЙЛА ПРОЕКТА
# entrypoint указывает файл, который является главным файлом программы.
# При запуске проекта Replit обращается к файлу "лр3.py".
entrypoint = "лр3.py"


# БЛОК ВЫБОРА ЯЗЫКА ПРОГРАММИРОВАНИЯ
# modules определяет используемую версию Python.
# В проекте применяется Python версии 3.11.
modules = ["python-3.11"]


# БЛОК НАСТРОЙКИ СИСТЕМНОГО ОКРУЖЕНИЯ
[nix]

# channel задает стабильный канал системных пакетов Nix.
channel = "stable-25_05"

# packages содержит список системных зависимостей,
# необходимых для корректной работы Python-проекта,
# построения графиков и обработки данных.
packages = [
  "cairo",                  # библиотека для графического вывода
  "ffmpeg-full",            # библиотека для обработки мультимедиа
  "freetype",               # библиотека для работы со шрифтами
  "ghostscript",            # средство обработки PostScript и PDF
  "glibcLocales",           # поддержка локалей и кодировок
  "gobject-introspection",  # поддержка взаимодействия с объектными библиотеками
  "gtk3",                   # библиотека графического интерфейса
  "pkg-config",             # средство настройки и поиска системных библиотек
  "qhull",                  # библиотека вычислительной геометрии
  "tcl",                    # системная библиотека Tcl
  "tk"                      # библиотека Tk для графических окон
]


# БЛОК НАСТРОЙКИ ТЕСТИРОВАНИЯ
[unitTest]

# language указывает язык, который используется для запуска тестов.
language = "python3"


# БЛОК НАСТРОЙКИ ИМПОРТА ИЗ GITHUB
[gitHubImport]

# requiredFiles задает обязательные конфигурационные файлы,
# которые должны присутствовать при импорте проекта.
requiredFiles = [".replit", "replit.nix"]


# БЛОК НАСТРОЙКИ РАЗВЕРТЫВАНИЯ
[deployment]

# run задает команду запуска приложения при развертывании.
# В данном случае запускается файл "лр3.py" с помощью Python 3.
run = ["python3", "лр3.py"]

# deploymentTarget определяет целевую платформу развертывания.
deploymentTarget = "cloudrun"


# БЛОК НАСТРОЙКИ ПОМОЩНИКА REPLIT
[agent]

# expertMode включает расширенный режим работы встроенного помощника Replit.
expertMode = true